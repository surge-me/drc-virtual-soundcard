<UserControl x:Class="DrcGui.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:DrcGui.Controls">
  <UserControl.Resources>
    <!-- 模式单选：WPF 默认外观在深色底上「未选中=实心白圆、选中=空心环」，与直觉相反（实测误判）。
         本模板改为「未选中=灰空环 / 选中=红环+红实心点」，与整体红色主题一致。 -->
    <Style x:Key="ModeRadio" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#E8E8EC"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <!-- Grid 两列（而非水平 StackPanel）：否则内容获得无限宽度 ⇒ 描述文本不换行被裁 -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid Grid.Column="0" Width="18" Height="18" VerticalAlignment="Top" Margin="0,2,0,0">
                <Ellipse x:Name="ring" Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.6"/>
                <Ellipse x:Name="dot" Width="8" Height="8" Fill="{StaticResource RedBrush}"
                         Visibility="Collapsed"/>
              </Grid>
              <ContentPresenter Grid.Column="1" Margin="9,0,0,0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                <Setter TargetName="ring" Property="Stroke" Value="{StaticResource RedBrush}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ring" Property="Stroke" Value="{StaticResource RedLightBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="4,0,0,6">
      <TextBlock Style="{StaticResource TitleText}" Text="设置"/>
      <TextBlock Style="{StaticResource SubText}" Text="高级参数 · 接入状态" Margin="0,6,0,0"/>
    </StackPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
      <StackPanel>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Style="{StaticResource SubText}" Text="音频模式" FontSize="14"/>
            <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="决定 DRC 从哪一层接入音频链（默认：虚拟声卡管道）"/>

            <RadioButton x:Name="RbVirtual" GroupName="AudioMode" Margin="0,14,0,0"
                         Style="{StaticResource ModeRadio}" Checked="OnAudioModeChecked">
              <StackPanel>
                <TextBlock Text="虚拟声卡管道（默认）" FontWeight="SemiBold" Foreground="#E8E8EC"/>
                <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,3,0,0"
                           Text="游戏声 → 虚拟音频线 → DRC → 默认输出。原厂驱动链与空间音效不受影响，任何设备可用；需安装虚拟音频线（VB-CABLE 等）"/>
              </StackPanel>
            </RadioButton>

            <RadioButton x:Name="RbApo" GroupName="AudioMode" Margin="0,12,0,0"
                         Style="{StaticResource ModeRadio}" Checked="OnAudioModeChecked">
              <StackPanel>
                <TextBlock Text="APO 注入（零附加延迟）" FontWeight="SemiBold" Foreground="#E8E8EC"/>
                <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,3,0,0"
                           Text="DRC 直接进入音频引擎处理；需安装器写入设备 FX 链，且与厂商效果（如 THX）互斥"/>
              </StackPanel>
            </RadioButton>

            <Border Background="#1E1E23" CornerRadius="8" Padding="12" Margin="0,14,0,0">
              <StackPanel>
                <Grid>
                  <TextBlock Style="{StaticResource DimText}" Text="路由器状态"/>
                  <TextBlock x:Name="LbRouterState" Text="—" HorizontalAlignment="Right"
                             Style="{StaticResource DimText}"/>
                </Grid>
                <Grid Margin="0,6,0,0">
                  <TextBlock Style="{StaticResource DimText}" Text="虚拟音频线（VB-CABLE）"/>
                  <TextBlock x:Name="LbCableState" Text="检测中…" HorizontalAlignment="Right"
                             Style="{StaticResource DimText}"/>
                </Grid>
                <TextBlock x:Name="LbRouterHint" Style="{StaticResource DimText}" TextWrapping="Wrap"
                           Margin="0,6,0,0" Text="—"/>
                <StackPanel x:Name="PnlCableInstall" Visibility="Collapsed" Margin="0,8,0,0">
                  <TextBlock x:Name="LbCableHint" Style="{StaticResource DimText}" TextWrapping="Wrap"
                             Text="未检测到虚拟音频线：一键从官方站点下载并安装 VB-CABLE（安装程序由官方提供，装完需重启电脑）。"/>
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="BtnCableInstall" Style="{StaticResource PrimaryBtn}" Content="一键下载并安装"
                            Click="OnInstallCable"/>
                    <Button x:Name="BtnCableManual" Style="{StaticResource SecondaryBtn}" Content="官网手动下载"
                            Margin="8,0,0,0" Click="OnOpenCableHome"/>
                  </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Button x:Name="BtnRouter" Style="{StaticResource PrimaryBtn}" Content="启动路由器"
                          Width="120" Click="OnRouterToggle"/>
                  <Button x:Name="BtnSoundSettings" Style="{StaticResource SecondaryBtn}" Content="打开声音设置"
                          Margin="8,0,0,0" Click="OnOpenSoundSettings"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Style="{StaticResource SubText}" Text="高级参数" FontSize="14"/>
            <Grid Margin="0,16,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="76"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource BodyText}" Text="前瞻时间" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource DimText}" Text="lookaheadMs" FontSize="11" Margin="0,2,0,0"/>
              </StackPanel>
              <Slider x:Name="SlLookahead" Style="{StaticResource HSliderRed}" Grid.Column="1"
                      Minimum="1" Maximum="10" TickFrequency="0.5" IsSnapToTickEnabled="True"
                      VerticalAlignment="Center" ValueChanged="OnLookaheadChanged"/>
              <ctl:NumberBox x:Name="NumLookahead" Grid.Column="2" Minimum="1" Maximum="10"
                             Step="0.5" Decimals="1" Unit="ms" Default="2.5" FontSize="14"
                             HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="76"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource BodyText}" Text="释放时间" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource DimText}" Text="releaseMs" FontSize="11" Margin="0,2,0,0"/>
              </StackPanel>
              <Slider x:Name="SlRelease" Style="{StaticResource HSliderRed}" Grid.Column="1"
                      Minimum="20" Maximum="500" TickFrequency="5" IsSnapToTickEnabled="True"
                      VerticalAlignment="Center" ValueChanged="OnReleaseChanged"/>
              <ctl:NumberBox x:Name="NumRelease" Grid.Column="2" Minimum="20" Maximum="500"
                             Step="5" Decimals="0" Unit="ms" Default="120" FontSize="14"
                             HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            <Grid Margin="0,14,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="76"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource BodyText}" Text="上抬封顶" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource DimText}" Text="maxBoostDb" FontSize="11" Margin="0,2,0,0"/>
              </StackPanel>
              <Slider x:Name="SlBoost" Style="{StaticResource HSliderRed}" Grid.Column="1"
                      Minimum="0" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True"
                      VerticalAlignment="Center" ValueChanged="OnBoostChanged"/>
              <ctl:NumberBox x:Name="NumBoost" Grid.Column="2" Minimum="0" Maximum="24"
                             Step="1" Decimals="0" Unit="dB" Default="10" FontSize="14"
                             HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Style="{StaticResource SubText}" Text="输出设备" FontSize="14"/>
            <ComboBox x:Name="CbDevice" Margin="0,10,0,0" SelectionChanged="OnDeviceChanged"/>
            <TextBlock x:Name="LbDeviceAuto" Style="{StaticResource DimText}" TextWrapping="Wrap"
                       Margin="0,8,0,0" Visibility="Collapsed"/>
            <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="只读枚举系统「活动」输出设备；APO 由安装器按设备注入 FX 链。"/>
            <DockPanel Margin="0,10,0,0">
              <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource BodyText}" Text="离线时自动切换" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource DimText}" Text="所选设备断开后自动改用其它可用输出" Margin="0,2,0,0"/>
              </StackPanel>
              <ToggleButton x:Name="SwAutoFallback" Style="{StaticResource SwitchOrange}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Checked="OnAutoFallbackToggled" Unchecked="OnAutoFallbackToggled"/>
            </DockPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Style="{StaticResource SubText}" Text="启动与默认" FontSize="14"/>
            <DockPanel Margin="0,10,0,0">
              <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource BodyText}" Text="开机自启" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource DimText}" Text="写入 HKCU 启动项" Margin="0,2,0,0"/>
              </StackPanel>
              <ToggleButton x:Name="SwAutoStart" Style="{StaticResource SwitchOrange}"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Checked="OnAutoStartToggled" Unchecked="OnAutoStartToggled"/>
            </DockPanel>
            <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,10,0,0"
                       Text="恢复出厂参数：ceiling -6 · floor -40 · maxBoost 10 · lookahead 2.5 · release 120 · EQ 全 0"/>
            <Button Style="{StaticResource PrimaryBtn}" Content="恢复默认" Width="120"
                    HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnResetDefaults"/>
            <!-- 配置落盘状态（报障③附带项）：路径 + 最近保存时刻 + 失败原因，不许静默失败 -->
            <TextBlock x:Name="LbConfig" Style="{StaticResource DimText}" TextWrapping="Wrap"
                       Margin="0,12,0,0" Text="—"/>
          </StackPanel>
        </Border>
      </StackPanel>
      </ScrollViewer>
      <Border Style="{StaticResource Card}" Margin="12,0,0,0" Grid.Column="1">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Style="{StaticResource SubText}" Text="接入状态" FontSize="14"/>
          <StackPanel DockPanel.Dock="Top" Margin="0,24,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Ellipse x:Name="BigDot" Width="18" Height="18" Fill="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
              <TextBlock x:Name="BigStatus" Text="未接管" FontSize="20" FontWeight="Bold"
                         Foreground="{StaticResource TextDimBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="StatusHint" Style="{StaticResource DimText}" HorizontalAlignment="Center"
                       Text="共享内存不存在：未检测到 APO 接管" TextAlignment="Center" Margin="0,10,0,0"/>
          </StackPanel>
          <!-- 全局快捷键：逐条列出（5 个组合键各自一行，避免"说 5 个只列 3 个"的歧义） -->
          <Border DockPanel.Dock="Top" Background="#1E1E23" CornerRadius="8" Padding="14" Margin="0,18,0,0">
            <StackPanel>
              <Grid>
                <TextBlock Style="{StaticResource DimText}" Text="全局快捷键"/>
                <TextBlock x:Name="LbHotkeyCount" Style="{StaticResource DimText}"
                           HorizontalAlignment="Right" Text="—"/>
              </Grid>
              <StackPanel x:Name="HotkeyRows" Margin="0,10,0,0"/>
              <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,10,0,0"
                         Text="按一次改 0.5 dB。窗口收到托盘后依然生效；被其它程序占用时该行标红。"/>
            </StackPanel>
          </Border>
          <StackPanel VerticalAlignment="Bottom" Margin="0,16,0,4">
            <Border Background="#1E1E23" CornerRadius="8" Padding="14">
              <StackPanel>
                <Grid>
                  <TextBlock Style="{StaticResource DimText}" Text="共享内存"/>
                  <TextBlock Text="Global\DrcApoSharedMem_v1" HorizontalAlignment="Right" Style="{StaticResource DimText}"/>
                </Grid>
                <Grid Margin="0,8,0,0">
                  <TextBlock Style="{StaticResource DimText}" Text="采样率 / 通道"/>
                  <TextBlock x:Name="LbRate" Text="—" HorizontalAlignment="Right" Style="{StaticResource DimText}"/>
                </Grid>
                <Grid Margin="0,8,0,0">
                  <TextBlock Style="{StaticResource DimText}" Text="算法延迟"/>
                  <TextBlock x:Name="LbLatency" Text="—" HorizontalAlignment="Right" Style="{StaticResource DimText}"/>
                </Grid>
                <Grid Margin="0,8,0,0">
                  <TextBlock Style="{StaticResource DimText}" Text="增益衰减"/>
                  <TextBlock x:Name="LbGain" Text="—" HorizontalAlignment="Right" Style="{StaticResource DimText}"/>
                </Grid>
                <Grid Margin="0,8,0,0">
                  <TextBlock Style="{StaticResource DimText}" Text="已处理帧"/>
                  <TextBlock x:Name="LbFrames" Text="—" HorizontalAlignment="Right" Style="{StaticResource DimText}"/>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
