<UserControl x:Class="DrcGui.Pages.EqPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="4,0,0,6">
            <TextBlock Style="{StaticResource TitleText}" Text="均衡器 EQ"/>
            <TextBlock Style="{StaticResource SubText}" Text="10 段 peaking · ±12dB · Q=1.1" Margin="0,6,0,0"/>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 响应曲线（与推子双向联动：拖曲线改最近频段） -->
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource SubText}" Text="频响曲线" FontSize="14"/>
                        <TextBlock Style="{StaticResource DimText}" Text="20Hz – 20kHz 对数轴 · 按住可直接拖动曲线" Margin="10,3,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,0,0,0">
                            <TextBlock Style="{StaticResource DimText}" Text="预设" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CbPreset" Margin="8,0,0,0" SelectionChanged="OnPresetChanged">
                                <ComboBoxItem Content="自定义" IsSelected="True"/>
                                <ComboBoxItem Content="脚步增强"/>
                                <ComboBoxItem Content="人声"/>
                                <ComboBoxItem Content="还原"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                    <Border Background="#1E1E23" CornerRadius="8" Margin="0,10,0,0" ClipToBounds="True" Height="220">
                        <Canvas x:Name="EqCanvas" SizeChanged="OnEqSizeChanged"
                                MouseLeftButtonDown="OnCanvasDown" MouseMove="OnCanvasMove" MouseLeftButtonUp="OnCanvasUp"/>
                    </Border>
                </DockPanel>
            </Border>

            <!-- 10 段推子 -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Grid.Row="1">
                <StackPanel x:Name="BandsHost" Orientation="Horizontal" HorizontalAlignment="Center"/>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
